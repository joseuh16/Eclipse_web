# ---------------------------------------------------------------------------
# Eclipse Tech - variables de entorno
# Copia este archivo a .env y cambia TODOS los valores marcados como CHANGE_ME.
# ---------------------------------------------------------------------------

# --- Firebase (Firestore + Auth) -------------------------------------------
# Crea un proyecto en https://console.firebase.google.com y copia estos valores
# desde "Configuración del proyecto > Tus apps > SDK de Firebase".
VITE_FIREBASE_API_KEY=CHANGE_ME_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=CHANGE_ME.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://CHANGE_ME-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=CHANGE_ME_project_id
VITE_FIREBASE_STORAGE_BUCKET=CHANGE_ME.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=CHANGE_ME_sender_id
VITE_FIREBASE_APP_ID=CHANGE_ME_app_id
VITE_FIREBASE_MEASUREMENT_ID=CHANGE_ME_measurement_id

# --- Backend (opcional, solo si mantienes la API .NET) ---------------------
# URL base de la API si sigues usando el backend propio.
VITE_API_URL=/api
VITE_DEV_API_PROXY=http://localhost:8090

# --- Admin -----------------------------------------------------------------
# Clave de firma JWT si mantienes la API .NET (mínimo 32 caracteres).
JWT_KEY=CHANGE_ME_generate_a_random_key_with_at_least_32_characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_admin_password

# --- Zona horaria ----------------------------------------------------------
TZ=America/Mexico_City